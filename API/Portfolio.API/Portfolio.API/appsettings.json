{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "ConnectionStrings": {
    "PortfolioConnectionString": "Server=localhost;Database=PortfolioDb;Trusted_Connection=True;TrustServerCertificate=True",
    "AuthConnectionString": "Server=localhost;Database=PortfolioAuthDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Portfolio.API",
    "Audience": "Portfolio.Admin",
    "ExpiryMinutes": 60
  }
}
